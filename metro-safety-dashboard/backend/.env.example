ENVIRONMENT=development
DATABASE_URL=sqlite:///./sql_app.db
# Para despliegue en AWS con RDS (PostgreSQL), descomenta y configura la siguiente linea:
# DATABASE_URL=postgresql://user:password@host:port/dbname
SECRET_KEY=super_secret_key_for_development_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://127.0.0.1", "http://127.0.0.1:8000", "*"]
